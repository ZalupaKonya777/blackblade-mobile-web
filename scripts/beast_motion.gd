static func _slope(keys:Array,i:int) -> float:
	if i==0 or i==keys.size()-1:return 0.0
	var a:float=(keys[i][1]-keys[i-1][1])/(keys[i][0]-keys[i-1][0])
	var b:float=(keys[i+1][1]-keys[i][1])/(keys[i+1][0]-keys[i][0])
	return 0.0 if a*b<=0 else 2*a*b/(a+b)

static func curve(keys:Array,time:float) -> float:
	if time<=keys[0][0]:return float(keys[0][1])
	for i in range(1,keys.size()):
		if time>keys[i][0]:continue
		var span:float=keys[i][0]-keys[i-1][0]
		var u:float=(time-keys[i-1][0])/span
		var u2:=u*u;var u3:=u2*u
		return (2*u3-3*u2+1)*keys[i-1][1]+(u3-2*u2+u)*span*_slope(keys,i-1)+(-2*u3+3*u2)*keys[i][1]+(u3-u2)*span*_slope(keys,i)
	return float(keys.back()[1])

static func sample(action:String,time:float,clock:float) -> Dictionary:
	var result:Dictionary=REST.duplicate()
	if action.begins_with("recover_"):
		var id:=action.trim_prefix("recover_")
		if TRACKS.has(id):
			var end:Dictionary=REST.duplicate()
			for key in TRACKS[id]:end[key]=curve(TRACKS[id][key],BeastMoves.ATTACKS[id].length)
			for key in BODY_TRACKS[id]:end[key]=curve(BODY_TRACKS[id][key],BeastMoves.ATTACKS[id].length)
			for k in result:result[k]=lerpf(end[k],result[k],smoothstep(0,.48,time))
		result.height-=sin(time*11)*exp(-time*7)*.012
		result.lean+=sin(time*11)*exp(-time*7)*.025
	elif TRACKS.has(action):
		for key in TRACKS[action]:result[key]=curve(TRACKS[action][key],time)
		for key in BODY_TRACKS[action]:result[key]=curve(BODY_TRACKS[action][key],time)
	elif action in ["stagger","hurt","critical"]:
		result.height=.23;result.lean=1.32;result.blade_pitch=-.16;result.blade_yaw=-1.2;result.hand_y=.24;result.paw_weight=1;result.head_pitch=.68
	elif action=="stagger_air":
		result.height=.28;result.lean=.90;result.blade_yaw=-1.4;result.blade_pitch=.32;result.flight=1;result.paw_weight=0;result.bank=sin(time*5)*.14
	elif action in ["roar","transition"]:
		var rise:=smoothstep(0,.72,time)*(1-smoothstep(1.65,2.55,time))
		result.height=lerpf(.33,.49,rise);result.lean=lerpf(1.12,.66,rise);result.head_pitch=-.18*rise;result.paw_weight=1-rise*.82;result.blade_pitch=lerpf(-.58,.94,rise);result.hand_y=lerpf(.68,.90,rise)
	elif action=="dead":
		var collapse:=smoothstep(.08,1.55,time)
		result.height=lerpf(.33,.18,collapse);result.lean=lerpf(1.12,1.35,collapse);result.bank=-.96*collapse;result.twist=-.30*collapse;result.paw_weight=1;result.hand_y=lerpf(.68,.16,collapse);result.blade_pitch=lerpf(-.58,-.10,collapse);result.blade_yaw=lerpf(-.25,-1.1,collapse);result.head_pitch=.40*collapse
	# The hips load first, the chest follows, and the head catches up after impact.
	# Existing move identities and all damage windows remain authoritative.
	if TRACKS.has(action):
		var m:Dictionary=BeastMoves.ATTACKS[action]
		for h in m.hits:
			var anticipation:=exp(-pow((time-(float(h[0])-.13))/.14,2))
			var impact:=exp(-pow((time-float(h[1]))/.10,2))
			var recoil:=exp(-maxf(0,time-float(h[1]))*8)*sin(maxf(0,time-float(h[1]))*17)
			result.height-=anticipation*.012+impact*.016
			result.head_pitch-=anticipation*.045
			result.head_pitch+=recoil*.055
			result.lean+=impact*.025-recoil*.018
	result.height+=(.035+sin(clock*1.7)*.003)*(1-float(result.flight))
	return result
